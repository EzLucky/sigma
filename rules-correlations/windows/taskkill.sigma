title: Process Termination via Taskkill
name: proc_creation_win_taskkill_process_termination
status: test
description: todo, just taskkill used to terminate a process.
references:
    - https://research.checkpoint.com/2026/dfir-report-the-gentlemen/
author: Luc Génaux
date: 2026-04-28
tags:
    - attack.defense-evasion
    - attack.t1562.001
logsource:
    product: windows
    category: process_creation
detection:
    selection:
        CommandLine|windash|contains|all:
            - 'taskkill'
            - '/im'
            - '/f'
    condition: selection

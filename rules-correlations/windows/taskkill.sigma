    product: windows
    category: process_creation
detection:
    selection_img:
        - OriginalFileName:
              - 'powershell.exe'
              - 'powershell_ise.exe'
              - 'pwsh.dll'
        - Image|endswith:
              - '\powershell.exe'
              - '\powershell_ise.exe'
              - '\pwsh.exe'
    selection_cli:
        CommandLine|contains: 'Stop-Process '
    condition: all of selection_*
level: low
---
title: Process Termination via PowerShell WMI cmdlet
id: b0186425-b9b5-4559-a5d5-d1cef7aaa475
name: proc_creation_win_powershell_wmi_cmdlet_process_termination
status: test
description: todo, just powershell used to terminate a process.
references:
    - https://research.checkpoint.com/2026/dfir-report-the-gentlemen/
author: Luc Génaux
date: 2026-04-28
tags:
    - attack.defense-evasion
    - attack.t1562.001
logsource:
    product: windows
    category: process_creation
detection:
    selection_img:
        - OriginalFileName:
              - 'powershell.exe'
              - 'powershell_ise.exe'
              - 'pwsh.dll'
        - Image|endswith:
              - '\powershell.exe'
              - '\powershell_ise.exe'
              - '\pwsh.exe'
    selection_psh_wmi_method:
        process|contains|all: 
            - 'Get-WmiObject '
            - 'Win32_Process'
            - '.Terminate()'
    selection_psh_cim_method:
        process|contains|all:
            - 'Get-CimInstance '
            - 'Win32_Process'
            - 'Invoke-CimMethod '
            - ' Terminate'
    condition: selection_img and selection_psh_wmi_method or selection_img and selection_psh_cim_method
level: low
---
